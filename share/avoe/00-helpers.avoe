--  Text helpers shared by the bundled modes.  The name makes this file
--  load before the mode files.

function Starts_With (S, Prefix : String) return Boolean is
begin
   return S'Length >= Prefix'Length and then S (1 .. Prefix'Length) = Prefix;
end Starts_With;

function Ends_With (S, Suffix : String) return Boolean is
begin
   return S'Length >= Suffix'Length
     and then S (S'Length - Suffix'Length + 1 .. S'Length) = Suffix;
end Ends_With;

function Is_Word_Char (C : Character) return Boolean is
begin
   return C in 'a' .. 'z' or else C in 'A' .. 'Z' or else C in '0' .. '9' or else C = '_';
end Is_Word_Char;

function Starts_With_Word (S, Word : String) return Boolean is
begin
   return Starts_With (S, Word)
     and then (S'Length = Word'Length or else not Is_Word_Char (S (Word'Length + 1)));
end Starts_With_Word;

function Ends_With_Word (S, Word : String) return Boolean is
begin
   return Ends_With (S, Word)
     and then (S'Length = Word'Length
               or else not Is_Word_Char (S (S'Length - Word'Length)));
end Ends_With_Word;

function Count_Char (S : String; C : Character) return Natural is
   N : Natural := 0;
begin
   for I in 1 .. S'Length loop
      if S (I) = C then
         N := N + 1;
      end if;
   end loop;
   return N;
end Count_Char;

--  The column of the first non-blank (tabs stop every 8 columns)
function Indent_Of (Text : String) return Natural is
   Column : Natural := 0;
begin
   for I in 1 .. Text'Length loop
      if Text (I) = ' ' then
         Column := Column + 1;
      elsif Text (I) = HT then
         Column := (Column / 8 + 1) * 8;
      else
         return Column;
      end if;
   end loop;
   return Column;
end Indent_Of;

--  S trimmed and without a '#' comment (one at the start or after a blank)
function Strip_Hash_Comment (S : String) return String is
begin
   for I in 1 .. S'Length loop
      if S (I) = '#' and then (I = 1 or else S (I - 1) = ' ' or else S (I - 1) = HT) then
         return Trim (S (1 .. I - 1));
      end if;
   end loop;
   return Trim (S);
end Strip_Hash_Comment;

--  Remove blanks before point (used before inserting a newline)
procedure Delete_Blanks_Before_Point is
begin
   while Point > Line_Beginning_Position
     and then (Char_Before = ' ' or else Char_Before = HT)
   loop
      Delete_Region (Point - 1, Point);
   end loop;
end Delete_Blanks_Before_Point;
