--  UCF mode for Avoe, written in Avoe script.
--
--  Highlighting for Xilinx ISE user constraint files.  Statement words
--  (NET, INST, TIMESPEC ...) are keywords, constraint names and their
--  values (LOC, IOSTANDARD, PERIOD, HIGH ...) are types.  UCF is case
--  insensitive.  # starts a comment.

Define_Mode
  (Name           => "ucf",
   Title          => "UCF",
   Extensions     => ".ucf",
   Keywords       => "net inst pin timespec timegrp config nodelay conflict_policy",
   Types          => "loc iostandard period tnm tnm_net tig drive slew pullup pulldown "
                     & "keeper offset in out before after high low fast slow quietio from "
                     & "to thru tpthru tpsync maxdelay maxskew datapathonly valid "
                     & "area_group range prohibit part vccaux iob iobdelay diff_term "
                     & "rloc rloc_origin u_set hu_set bel keep keep_hierarchy save "
                     & "clock_dedicated_route feedback phase_shift in_term out_term "
                     & "input_jitter fall rising falling except priority "
                     & "ns ps us ms khz mhz ghz true false yes no",
   Line_Comment   => "#",
   Case_Sensitive => False);
