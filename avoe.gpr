project Avoe is

   for Languages use ("Ada", "C");
   for Toolchain_Name ("C") use "GCC";
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("avoe.adb");

   package Builder is
      for Executable ("avoe.adb") use "avoe";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2012", "-gnatwa", "-gnata", "-gnatVa", "-g", "-O2");
      for Default_Switches ("C") use ("-Wall", "-Wextra", "-g", "-O2");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   --  "alr install" copies files with gprinstall, which only knows what is
   --  listed here: the program with its bundled scripts, documentation and
   --  man page, in the layout avoe looks for (PREFIX/bin, PREFIX/share/avoe)
   package Install is
      for Mode use "usage";
      for Artifacts ("share/avoe") use ("share/avoe/*.avoe");
      for Artifacts ("share/doc/avoe") use
        ("README.md", "CHANGELOG.md", "LICENSE", "docs/avoe-script.md", "examples/avoerc.avoe");
      for Artifacts ("share/man/man1") use ("docs/avoe.1");
   end Install;

end Avoe;
